NODE_ENV=development

# Public service ports
BACKEND_PORT=5000
GAME_PORT=5001
HTTP_PORT=5173

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=42trc_game
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/42trc_game

# Game-server database settings for local non-Compose runs
DB_HOST=localhost
DB_PORT=5432
DB_NAME=42trc_game
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=change-this-in-development
FRONTEND_URL=http://localhost:5173
ALLOWED_SCHOOL_EMAIL_DOMAINS=42.fr,student.42.fr,student.42heilbronn.de

# 42 OAuth
OAUTH_42_CLIENT_ID=replace-me
OAUTH_42_CLIENT_SECRET=replace-me
OAUTH_42_REDIRECT_URI=http://localhost:5173/login
OAUTH_42_SCOPE=public

# Optional API seed/sync settings.
SEED_API_CONCURRENCY=8
SEED_API_RATE=2

# Frontend build/runtime values
VITE_API_URL=
VITE_GAME_SERVER_URL=/game
